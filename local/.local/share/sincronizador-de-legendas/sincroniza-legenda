#!/bin/bash

TARGET_DIR="${1}"

if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
    echo "Uso: sincroniza_legenda /caminho/do/mount/do/raspberry"
    exit 1
fi

# Acha o caminho real resolvendo o link simbólico
SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# Chama o Python isolado pelo pescoço
VENV_PYTHON="$SCRIPT_DIR/whisper-env/bin/python"

# ---> A VACINA DO CUDA ENTRA AQUI <---
export LD_LIBRARY_PATH="$SCRIPT_DIR/whisper-env/lib/python3.14/site-packages/nvidia/cublas/lib:/opt/cuda/lib64:$LD_LIBRARY_PATH"


WORK_DIR="$HOME/.cache/sincronizador_work_$$"
mkdir -p "$WORK_DIR"

echo "Modo trator ativado. Área de trabalho local no SSD: $WORK_DIR"

shopt -s nullglob globstar

for video in "$TARGET_DIR"/**/*.{mkv,mp4}; do
    base_video="$(basename "$video")"
    dir_video="$(dirname "$video")"
    base_nome="${base_video%.*}"
    
    # Mapeamento da rede
    legenda_rede="$dir_video/$base_nome.srt"
    legenda_bak_rede="$dir_video/$base_nome.srt.bak"

    # Se não tem a legenda zoada, pula
    if [ ! -f "$legenda_rede" ]; then
        continue
    fi
    
    echo "================================================="
    echo "[+] Processando: $base_video"
    echo "[*] Trazendo o vídeo pro SSD..."
    
    # Barreira 1: Se o rsync capotar, a gente aborta antes de piorar
    cp "$video" "$WORK_DIR/$base_video"
    # if ! rsync -vP -W --inplace "$video" "$WORK_DIR/"; then
    #     echo "[!] A rede piscou e o rsync arregou. Pulando este episódio."
    #     rm -f "$WORK_DIR"/*
    #     continue
    # fi

    # Traz a legenda (o cp resolve isso num milissegundo)
    cp "$legenda_rede" "$WORK_DIR/$base_nome.srt"

    video_local="$WORK_DIR/$base_video"
    legenda_pt_local="$WORK_DIR/$base_nome.srt"
    legenda_en_local="$WORK_DIR/$base_nome.en.srt"
    legenda_sync_local="$WORK_DIR/$base_nome.sync.srt"

    echo "[*] Testando se o arquivo copiado não é um zumbi decapitado..."
    # Barreira 2: O ffprobe tenta ler a estrutura do arquivo. Se falhar, é lixo.
    if ! ffprobe -v error -i "$video_local" > /dev/null 2>&1; then
        echo "[!] O arquivo chegou corrompido e o ffprobe infartou."
        echo "[!] Abortando missão para poupar o Python..."
        rm -f "$WORK_DIR"/*
        continue
    fi

    echo "[*] Chamando o Whisper na placa de vídeo..."
    "$VENV_PYTHON" "$SCRIPT_DIR/ancora.py" "$video_local"
    
    echo "[*] Vacinando o encoding da legenda..."
    "$VENV_PYTHON" "$SCRIPT_DIR/limpa_encoding.py" "$legenda_pt_local"

    if [ -f "$legenda_en_local" ]; then
        echo "[*] ALASS: Alinhando os tempos..."
        alass "$legenda_en_local" "$legenda_pt_local" "$legenda_sync_local"
        
        echo "[*] Transformando a legenda velha em backup (.bak)..."
        mv "$legenda_rede" "$legenda_bak_rede"

        echo "[*] Salvando a legenda perfeita no lugar da original..."
        cp "$legenda_sync_local" "$legenda_rede"
        
        echo "[+] Sucesso! Arquivo pronto."
    else
        echo "[!] O Whisper engasgou. Âncora não gerada."
    fi

    echo "[*] Limpando o SSD..."
    rm -f "$WORK_DIR"/*
done

rm -rf "$WORK_DIR"

echo "================================================="
echo "Acabou a brincadeira. Tudo renomeado e no esquema lá no Raspberry."
