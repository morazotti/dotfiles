#!/bin/bash

format="mkv"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--format)
            format="$2"
            shift 2
            ;;
        -f=*|--format=*)
            format="${1#*=}"
            shift
            ;;
        -h|--help)
            echo "Usage: $0 [-f|--format FORMAT] <input-file> [input-file2 ...]"
            echo "  -f, --format FORMAT   Set output format (default: mkv)"
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            inputs+=("$1")
            shift
            ;;
    esac
done

if [[ ${#inputs[@]} -eq 0 ]]; then
    echo "Usage: $0 [-f|--format FORMAT] <input-file> [input-file2 ...]" >&2
    exit 1
fi

for input in "${inputs[@]}"; do
    if [[ ! -f "$input" ]]; then
        echo "Error: file not found: $input" >&2
        continue
    fi
    name=$(basename "$input")
    ffmpeg -i "$input" -c copy "${name%.*}.${format}"
done
